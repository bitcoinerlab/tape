Subject: Pin security-corrected dependencies for Esplora and its nested projects
Base: Blockstream/esplora 09f8508d51f3f4da122b514a94fa4183740fd764

The lockfiles select corrected HTTP, crypto and Babel helper dependencies.
Generated JavaScript must be compatible with the envify 4 parser, which does
not support object-spread syntax. The postinstall script uses npm ci for both
nested projects so all three projects install their locked dependencies.
See README.md here for scope and regeneration commands.

diff --git a/package.json b/package.json
--- a/package.json
+++ b/package.json
@@ -4,7 +4,7 @@
   "scripts": {
     "dev-server": "babel-node dev-server.js",
     "prerender-server": "cd prerender-server && npm start",
-    "postinstall": "(cd client && npm install) && (cd prerender-server && npm install)",
+    "postinstall": "(cd client && npm ci) && (cd prerender-server && npm ci)",
     "dist": "./build.sh",
     "l10n:fetch": "./lang/util/fetch-transifex.sh",
     "l10n:update-strings": "./lang/util/update-strings.sh"
